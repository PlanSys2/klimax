/// \file
/// \brief Klimax version (generated by CMake).

#ifndef KLIMAX__VERSION_HPP_
#define KLIMAX__VERSION_HPP_

#include <string_view>

#include "klimax/export.hpp"

#define KLIMAX_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define KLIMAX_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define KLIMAX_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define KLIMAX_VERSION_STRING "@PROJECT_VERSION@"

namespace klimax
{

/// @brief Version of the library actually linked (may differ from the headers).
KLIMAX_API std::string_view version();

/// @brief Version of the Kairos modules built into this library.
KLIMAX_API std::string_view kairos_version();

}  // namespace klimax

#endif  // KLIMAX__VERSION_HPP_
