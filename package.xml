<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>klimax</name>
  <version>0.0.1</version>
  <description>HTN planner for HDDL 2.1 (hierarchical, numeric and temporal), usable as a library and as an executable</description>
  <maintainer email="fmrico@gmail.com">Francisco Martín Rico</maintainer>
  <license>Apache-2.0</license>

  <url type="repository">https://github.com/PlanSys2/klimax</url>
  <author email="fmrico@gmail.com">Francisco Martín Rico</author>

  <buildtool_depend>cmake</buildtool_depend>

  <depend>kairos</depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
